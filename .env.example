# Copy this file to .env on the Ubuntu server, then replace every CHANGE_ME value.
# Do not commit the resulting .env file.
COMPOSE_PROJECT_NAME=enterprise-kb
TZ=Asia/Shanghai
DATA_ROOT=/data/enterprise-kb
HOST_BIND_IP=127.0.0.1
# Bind only the web UI to the office LAN when required. Keep HOST_BIND_IP on loopback.
FRONTEND_BIND_IP=127.0.0.1
API_PORT=8000
FRONTEND_PORT=18080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MYSQL_PORT=3306
REDIS_PORT=6379
MILVUS_PORT=19530
OPENSEARCH_PORT=9200

MYSQL_DATABASE=enterprise_kb
MYSQL_USER=kb_app
MYSQL_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_PASSWORD

MINIO_ROOT_USER=kb_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_AT_LEAST_8_CHARACTERS
MINIO_BUCKET=enterprise-kb

# Password must meet OpenSearch complexity requirements.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=CHANGE_ME_StrongPassword_2026!
OPENSEARCH_HEAP_SIZE=4g

APP_ENV=production
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:3000

# Leave blank until an approved external model provider is selected.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
ASSISTANT_INTENT_TIMEOUT_SECONDS=15
# Fernet key used to encrypt model-provider API keys stored by the gateway.
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MODEL_CREDENTIAL_KEY=
# Fail-closed outbound allowlists. Hosts are exact (no wildcards). Private IPs
# must be allowed by both the corresponding HOSTS and CIDRS lists.
MCP_ALLOWED_HOSTS=192.168.1.33
MCP_ALLOWED_CIDRS=192.168.1.0/24
MODEL_ALLOWED_HOSTS=dashscope.aliyuncs.com,infinity
# Common Docker bridge range; restricted to the exact hosts above.
# Production: narrow to the actual enterprise-kb-internal subnet (see README).
# Custom Docker address pools outside this range require explicit adjustment.
MODEL_ALLOWED_CIDRS=172.16.0.0/12
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
MAX_UPLOAD_BYTES=209715200

# Authentication. Generate both secrets before the first production start.
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
JWT_EXPIRE_MINUTES=480
AUTH_COOKIE_SECURE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_USE_A_STRONG_INITIAL_ADMIN_PASSWORD
ADMIN_DISPLAY_NAME=平台管理员

# Configure an approved embedding endpoint and model before production rollout.
# local_hash and LOCAL_TEST_MODE=true are allowed only outside APP_ENV=production.
EMBEDDING_PROVIDER=openai_compatible
LOCAL_EMBEDDING_DIM=384
LOCAL_TEST_MODE=false
MILVUS_COLLECTION=kb_content_units_v1
OPENSEARCH_INDEX=kb-content-units-v1
